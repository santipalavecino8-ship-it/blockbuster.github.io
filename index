<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ayudá a donar un plato de comida · Programa Supersopa</title>
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --green:#00785c; --green-dark:#005a45; --yellow:#fffc95; --red:#f6254c; --red-dark:#c71a3b;
  --bg:#00785c; --surface:#ffffff; --text:#0f2a22; --muted:#486a5f; --border:#d3e8df; --title:#00785c;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#00513f; --green-dark:#003a2d; --surface:#11372d; --text:#eaf5f0; --muted:#a9c9bd; --border:#245a4b; --title:#fffc95;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#00513f; --green-dark:#003a2d; --surface:#11372d; --text:#eaf5f0; --muted:#a9c9bd; --border:#245a4b; --title:#fffc95;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:#00785c;background:linear-gradient(180deg,var(--bg),color-mix(in srgb,var(--bg) 90%,#000));color:var(--text);font-family:"Poppins","Segoe UI",system-ui,-apple-system,Arial,sans-serif;line-height:1.5}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--green);z-index:10}

header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--green);display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 5vw;box-shadow:0 2px 10px rgba(0,0,0,.2)}
header a{display:flex;align-items:center}
.logo img{height:56px;width:auto;display:block}
.unq img{height:36px;width:auto;display:block}

.hero{position:relative;z-index:1;color:#fff;text-align:center;padding:clamp(56px,10vw,110px) 5vw clamp(80px,12vw,130px)}
.hero h1{margin:0 auto;max-width:900px;font-size:clamp(2rem,6.5vw,4.4rem);line-height:1.08;font-weight:800;text-transform:uppercase;letter-spacing:.5px}
.hero h1 span{color:#fff}
.hero h2{margin:30px auto 0;display:inline-block;background:var(--red);color:#fff;font-size:clamp(1.1rem,3vw,1.6rem);font-weight:700;padding:10px 26px;border-radius:999px;text-transform:uppercase}
.hero .arrow{display:block;margin-top:16px;font-size:1.8rem;color:var(--yellow);animation:bob 1.6s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(8px)}}
@media (prefers-reduced-motion:reduce){.hero .arrow{animation:none}}

main{position:relative;z-index:1;max-width:640px;margin:-60px auto 0;padding:0 5vw 60px}
.card{background:var(--surface);border:1px solid var(--border);border-top:6px solid var(--yellow);border-radius:18px;padding:0;overflow:hidden;box-shadow:0 12px 30px rgba(0,0,0,.25)}
.card h3{margin:0;background:var(--green);color:#fff;padding:16px 28px;font-size:1.1rem;text-align:center;letter-spacing:.5px}
.card .body{padding:12px 28px 28px}
.steps{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:640px;margin:34px auto 0;text-align:center}
.step{background:var(--surface);color:var(--text);border-radius:16px;padding:20px 14px;box-shadow:0 8px 20px rgba(0,0,0,.2);position:relative;text-align:center;border-bottom:5px solid var(--yellow);animation:pop .8s cubic-bezier(.2,.9,.3,1.25) both,float 4s ease-in-out 1s infinite;transition:transform .2s}
.step:nth-child(2){animation-delay:.25s,1.4s}
.step:hover{transform:translateY(-4px) scale(1.03)}
@keyframes pop{0%{opacity:0;transform:translateY(40px) scale(.8)}100%{opacity:1;transform:none}}
@keyframes float{0%,100%{translate:0 0}50%{translate:0 -6px}}
@keyframes ring{0%{box-shadow:0 0 0 0 rgba(255,252,149,.7)}100%{box-shadow:0 0 0 14px rgba(255,252,149,0)}}
.notice{display:inline-block;margin:24px auto 0;background:var(--yellow);color:#00513f;font-weight:700;font-size:.95rem;padding:10px 20px;border-radius:999px;box-shadow:0 6px 16px rgba(0,0,0,.2);animation:pop .8s .6s cubic-bezier(.2,.9,.3,1.25) both}
@media (prefers-reduced-motion:reduce){.step,.notice,.step .n{animation:none}}
.step .n{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--yellow);color:#00513f;font-weight:800;margin-bottom:10px;animation:ring 1.8s ease-out infinite}
.step b{display:block;font-size:1rem;margin-bottom:4px}
.step p{margin:0;font-size:.85rem;color:var(--muted);line-height:1.4}
@media (max-width:420px){.steps{gap:10px}.step{padding:12px}.step b{font-size:.92rem}.step p{font-size:.78rem}}
.row{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border)}
.row .k{color:var(--muted);font-size:.9rem}
.row .v{font-weight:600;text-align:right}
.cbu{margin-top:14px;text-align:center;font-family:ui-monospace,Consolas,monospace;font-size:1.05rem;letter-spacing:1px;color:var(--muted);word-break:break-all}
.btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;border:0;cursor:pointer;font:inherit;font-weight:700;font-size:1rem;border-radius:12px;padding:15px 20px;text-decoration:none;transition:transform .15s,background .2s}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--red);color:#fff;margin-top:14px}
.btn-primary:hover{background:var(--red-dark)}
.btn-primary.ok{background:var(--green);color:#fff}
.btn-mail{background:var(--red);color:#fff}
.btn-mail:hover{background:var(--red-dark)}

.important{margin-top:26px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-top:6px solid var(--red);border-radius:18px;padding:28px;text-align:center;box-shadow:0 12px 30px rgba(0,0,0,.25)}
.important strong{display:block;color:var(--red);font-size:1.1rem;letter-spacing:2px;margin-bottom:10px}
.important p{margin:0 0 16px;font-weight:700}

footer{position:relative;z-index:1;background:var(--green-dark);color:#fff;text-align:center;padding:28px 5vw;font-size:.85rem}
footer a{color:var(--yellow)}
.sr{position:absolute;left:-9999px}
</style>
</head>
<body>

<header>
  <a class="logo" href="https://supersopa.unq.edu.ar/" aria-label="Programa Supersopa"><img src="data:image/png;base64," alt="Programa Supersopa"></a>
  <a class="unq" href="https://supersopa.unq.edu.ar/" aria-label="Universidad Nacional de Quilmes"><img src="data:image/png;base64," alt="UNQ"></a>
</header>

<section class="hero">
  <h1>Ayudá a donar <span>un plato de comida</span></h1>
  <h2>¿Cómo hacerlo?</h2>
  <div class="steps">
    <div class="step"><span class="n">1</span><b>📋 Copiá el CBU</b><p>Usá el botón de abajo y hacé la transferencia desde tu banco o billetera virtual.</p></div>
    <div class="step"><span class="n">2</span><b>✉️ Pasanos el comprobante</b><p>Enviálo por mail para que podamos hacer efectiva tu donación.</p></div>
  </div>
  <p class="notice">RECORDÁ QUE PODÉS DONAR A PARTIR DE LOS 1.000ARS</p>
</section>

<main>
  <section class="card" aria-label="Datos para la transferencia">
    <h3>DATOS</h3>
    <div class="body">
    <div class="row"><span class="k">Titular</span><span class="v">Universidad Nacional de Quilmes</span></div>
    <div class="row"><span class="k">Banco</span><span class="v">Banco de la Nación Argentina</span></div>
    <div class="row"><span class="k">Sucursal</span><span class="v">9214 - Bernal</span></div>
    <div class="cbu">CBU: 0110054920000199240957</div>
    <button class="btn btn-primary" id="copyBtn" type="button">📋 Copiar CBU</button>
    <span class="sr" role="status" aria-live="polite" id="live"></span>
    </div>
  </section>

  <section class="important">
    <strong>IMPORTANTE</strong>
    <p>RECORDÁ ADJUNTAR EL COMPROBANTE UNA VEZ REALIZADA LA TRANSFERENCIA A ESTE CORREO</p>
    <a class="btn btn-mail" href="mailto:supersopa@unq.edu.ar?subject=Comprobante%20de%20donaci%C3%B3n%20-%20Supersopa&amp;body=Hola%2C%20adjunto%20el%20comprobante%20de%20mi%20transferencia.%20%C2%A1Gracias!">✉️ supersopa@unq.edu.ar</a>
  </section>
</main>

<footer>
  <p>Programa Supersopa · Universidad Nacional de Quilmes, Bernal<br>
  <a href="tel:+541143657100">(+54) 11 4365-7100 Int. 5655</a></p>
  <p>© 2026 Programa Supersopa</p>
</footer>

<script>
(function(){
  var CBU="0110054920000199240957";
  var btn=document.getElementById("copyBtn");
  var live=document.getElementById("live");
  function done(){
    btn.classList.add("ok");
    btn.textContent="✅ ¡CBU copiado!";
    live.textContent="CBU copiado al portapapeles";
    setTimeout(function(){btn.classList.remove("ok");btn.textContent="📋 Copiar CBU";},2500);
  }
  function fallback(){
    var t=document.createElement("textarea");
    t.value=CBU;t.style.position="fixed";t.style.opacity="0";
    document.body.appendChild(t);t.select();
    try{document.execCommand("copy");done();}catch(e){window.prompt("Copiá el CBU:",CBU);}
    document.body.removeChild(t);
  }
  btn.addEventListener("click",function(){
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(CBU).then(done,fallback);
    }else{fallback();}
  });
})();
</script>
</body>
</html>
